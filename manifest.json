{
  "name": "MHR-Inven-Monster-Extension",
  "description": "몬스터헌터 라이즈 인벤 몬스터 정보 페이지 기능을 확장 합니다.",
  "version": "1.2.0",
  "manifest_version": 3,
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "MHR-Inven-Monster-Extension",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "permissions": ["tabs"],
  "background": {
    "service_worker": "src/background/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mhf.inven.co.kr/dataninfo/mhr/monster/*"
      ],
      "css": [
        "src/content/ui.css"
      ],
      "js": [
        "src/content/common.js",
        "src/content/search-parser.js",
        "src/content/monsters.data.js",
        "src/content/monsters.js",
        "src/content/filter-state.js",
        "src/content/ui-form.js",
        "src/content/ui-table.js",
        "src/content/search.js"
      ]
    }
  ]
}

